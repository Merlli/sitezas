# Os quatro segredos abaixo ficam vazios de propósito. Não coloque exemplo.
# Rode ./scripts/subir.sh: ele gera valores aleatórios na primeira vez.
# Trocar SECRET ou KEY depois do primeiro sobe invalida as sessões do painel.

# Assinatura das sessões do Directus. Uma vez, 64 caracteres hex. Não troque.
DIRECTUS_SECRET=

# Segunda chave do Directus. Uma vez, 64 caracteres hex. Não troque.
DIRECTUS_KEY=

# Primeiro acesso ao painel. O Directus só usa estes valores enquanto o banco está vazio.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# Endereço em que o editor abre o painel, sem barra no final.
# Local: http://localhost  (ou http://localhost:PORTA se a porta pública não for 80)
# Produção: https://painel.seudominio
PUBLIC_URL=http://localhost

# Porta do proxy no host. O Directus não tem porta própria no host.
PORTA_PUBLICA=80

# Segredo que o fluxo do Directus envia ao site para trocar o cache.
# A rota só existe na rede interna do Docker. O proxy público recusa /api/.
REVALIDAR_SEGREDO=

# Endereço do Directus visto de dentro do Docker. O site usa este valor.
# Não aponte para um endereço público.
DIRECTUS_INTERNO=http://directus:8055
